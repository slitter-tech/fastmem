# Метаданные
include README.md
include README_RU.md
include LICENSE
include CHANGELOG.md
include pyproject.toml
include setup.py

# C-исходник нужен в sdist, иначе расширение нечем собирать
include src/fastmem/_fastmem.c

recursive-include tests *.py

# Собранное расширение в sdist не нужно
exclude src/fastmem/*.pyd
exclude src/fastmem/*.so
prune build
prune dist
global-exclude __pycache__ *.py[cod]
