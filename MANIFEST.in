# Metadata
include README.md
include README_RU.md
include LICENSE
include CHANGELOG.md
include pyproject.toml
include setup.py

# The C source must ship in the sdist: without it there is nothing to
# compile when pip builds from source.
include src/fastmem/_fastmem.c

# The standalone C library and the header-only C++ wrapper, so the sdist is
# a complete source distribution of the project rather than of the Python
# half only.
include csrc/fastmem.h
include csrc/fastmem.c
include csrc/fastmem.def
include cpp/include/fastmem/fastmem.hpp
include cpp/examples/quickstart.cpp
include tools/build_native.py
# setup.py imports this, so an sdist without it cannot build the extension
# at all - and the failure surfaces only at install time on the user's
# machine.
include tools/msvc_paths.py
include tools/release_check.py
include docs/C_API.md

recursive-include tests *.py

# The prebuilt extension must not ship in the sdist.
exclude src/fastmem/*.pyd
exclude src/fastmem/*.so
prune build
prune dist
global-exclude __pycache__ *.py[cod]